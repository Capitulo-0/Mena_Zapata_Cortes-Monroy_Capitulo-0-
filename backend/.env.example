# Template only. Export these variables in the process that launches Java/Maven.
# Spring Boot does not automatically load this file or a .env file.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# PostgreSQL URL format: jdbc:postgresql://<host>:5432/<database>
# Neon requires a JDBC PostgreSQL URL with TLS parameters supplied by Neon,
# for example the same format followed by ?sslmode=require.
# Never commit actual hostnames, connection strings, passwords or keys.
